// Hình 2.2 – Lược đồ quan hệ CSDL phòng khám & y tế từ xa (T31).
// Khóa chính gạch chân, khóa ngoại đánh dấu #; mũi tên đi từ khóa ngoại tới khóa được tham chiếu.
// Màu theo ERD tổng: xanh dương mảng A, xanh lá mảng B, cam mảng C, vàng danh mục.
// Vị trí bảng cố định theo lưới 6 cột × 4 hàng (pos=…!): A bên trái, B giữa, C bên phải;
// mỗi khóa ngoại nối bảng kề nhau hoặc đi qua khe giữa các bảng. Xuất ảnh:
//   neato -n2 -Tpng -Gdpi=200 LuocDo_QuanHe.dot -o LuocDo_QuanHe.png
digraph LuocDoQuanHe {
  graph [layout=neato, splines=true, overlap=false, fontname="Helvetica", pad=0.2];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [arrowsize=0.7, color="#555555"];

  // ---------- Mảng A ----------
  NHAN_VIEN [pos="350,580!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#dae8fc"><B>NHAN_VIEN</B></TD></TR>
    <TR><TD PORT="ma_nv" ALIGN="LEFT"><U>ma_nv</U></TD></TR>
    <TR><TD ALIGN="LEFT">ho_ten, ngay_sinh</TD></TR>
    <TR><TD ALIGN="LEFT">sdt, email, loai_nv</TD></TR></TABLE>>];
  BAC_SI [pos="350,410!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#dae8fc"><B>BAC_SI</B></TD></TR>
    <TR><TD PORT="ma_bac_si" ALIGN="LEFT"><U>#ma_bac_si</U></TD></TR>
    <TR><TD ALIGN="LEFT">so_chung_chi</TD></TR>
    <TR><TD ALIGN="LEFT">ngay_cap_cc, ngay_het_han_cc</TD></TR>
    <TR><TD ALIGN="LEFT">loai_bac_si</TD></TR></TABLE>>];
  BAC_SI_DA_KHOA [pos="110,230!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#dae8fc"><B>BAC_SI_DA_KHOA</B></TD></TR>
    <TR><TD PORT="ma_bac_si" ALIGN="LEFT"><U>#ma_bac_si</U></TD></TR></TABLE>>];
  BAC_SI_CHUYEN_KHOA [pos="350,230!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#dae8fc"><B>BAC_SI_CHUYEN_KHOA</B></TD></TR>
    <TR><TD PORT="ma_bac_si" ALIGN="LEFT"><U>#ma_bac_si</U></TD></TR>
    <TR><TD PORT="ma_chuyen_khoa" ALIGN="LEFT">#ma_chuyen_khoa</TD></TR></TABLE>>];
  CHUYEN_KHOA [pos="110,70!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#fff2cc"><B>CHUYEN_KHOA</B></TD></TR>
    <TR><TD PORT="ma_chuyen_khoa" ALIGN="LEFT"><U>ma_chuyen_khoa</U></TD></TR>
    <TR><TD ALIGN="LEFT">ten_chuyen_khoa</TD></TR></TABLE>>];
  CA_LAM_VIEC [pos="110,410!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#dae8fc"><B>CA_LAM_VIEC</B></TD></TR>
    <TR><TD ALIGN="LEFT"><U>ma_ca</U></TD></TR>
    <TR><TD ALIGN="LEFT">thoi_gian_bd, thoi_gian_kt</TD></TR>
    <TR><TD ALIGN="LEFT">trang_thai</TD></TR>
    <TR><TD PORT="ma_bac_si" ALIGN="LEFT">#ma_bac_si</TD></TR></TABLE>>];

  // ---------- Mảng B ----------
  BENH_NHAN [pos="590,230!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#d5e8d4"><B>BENH_NHAN</B></TD></TR>
    <TR><TD PORT="ma_bn" ALIGN="LEFT"><U>ma_bn</U></TD></TR>
    <TR><TD ALIGN="LEFT">ho_ten, ngay_sinh, gioi_tinh</TD></TR>
    <TR><TD ALIGN="LEFT">sdt, email</TD></TR></TABLE>>];
  GIAY_CHUYEN_KHOA [pos="350,70!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#d5e8d4"><B>GIAY_CHUYEN_KHOA</B></TD></TR>
    <TR><TD PORT="ma_giay" ALIGN="LEFT"><U>ma_giay</U></TD></TR>
    <TR><TD ALIGN="LEFT">ngay_lap, ly_do, ngay_het_han</TD></TR>
    <TR><TD PORT="ma_bn" ALIGN="LEFT">#ma_bn</TD></TR>
    <TR><TD PORT="ma_bac_si_lap" ALIGN="LEFT">#ma_bac_si_lap</TD></TR>
    <TR><TD PORT="ma_chuyen_khoa" ALIGN="LEFT">#ma_chuyen_khoa</TD></TR></TABLE>>];
  LICH_HEN [pos="590,410!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#d5e8d4"><B>LICH_HEN</B></TD></TR>
    <TR><TD PORT="ma_lh" ALIGN="LEFT"><U>ma_lh</U></TD></TR>
    <TR><TD ALIGN="LEFT">thoi_gian_bd, thoi_gian_kt, ly_do_kham</TD></TR>
    <TR><TD ALIGN="LEFT">trang_thai, hinh_thuc, phi_kham, ngay_tao</TD></TR>
    <TR><TD ALIGN="LEFT">phong_kham, nen_tang, link_phien</TD></TR>
    <TR><TD PORT="ma_bn" ALIGN="LEFT">#ma_bn</TD></TR>
    <TR><TD PORT="ma_bac_si" ALIGN="LEFT">#ma_bac_si</TD></TR>
    <TR><TD PORT="ma_giay" ALIGN="LEFT">#ma_giay</TD></TR></TABLE>>];
  TAI_KHOAN [pos="830,580!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#d5e8d4"><B>TAI_KHOAN</B></TD></TR>
    <TR><TD PORT="ten_dang_nhap" ALIGN="LEFT"><U>ten_dang_nhap</U></TD></TR>
    <TR><TD ALIGN="LEFT">mat_khau_hash, vai_tro, trang_thai</TD></TR>
    <TR><TD PORT="ma_bn" ALIGN="LEFT">#ma_bn</TD></TR>
    <TR><TD PORT="ma_nv" ALIGN="LEFT">#ma_nv</TD></TR></TABLE>>];

  // ---------- Mảng C ----------
  LAN_KHAM [pos="830,410!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#ffe6cc"><B>LAN_KHAM</B></TD></TR>
    <TR><TD PORT="ma_lan_kham" ALIGN="LEFT"><U>ma_lan_kham</U></TD></TR>
    <TR><TD PORT="ma_lh" ALIGN="LEFT">#ma_lh</TD></TR>
    <TR><TD ALIGN="LEFT">thoi_diem_kham, tom_tat</TD></TR>
    <TR><TD PORT="created_by" ALIGN="LEFT">#created_by</TD></TR></TABLE>>];
  CHAN_DOAN [pos="1070,410!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#ffe6cc"><B>CHAN_DOAN</B></TD></TR>
    <TR><TD ALIGN="LEFT"><U>ma_chan_doan</U></TD></TR>
    <TR><TD PORT="ma_lan_kham" ALIGN="LEFT">#ma_lan_kham</TD></TR>
    <TR><TD PORT="ma_icd10" ALIGN="LEFT">#ma_icd10</TD></TR>
    <TR><TD ALIGN="LEFT">la_chan_doan_chinh, ghi_chu, trang_thai</TD></TR></TABLE>>];
  MA_ICD10 [pos="1310,410!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#fff2cc"><B>MA_ICD10</B></TD></TR>
    <TR><TD PORT="ma_icd10" ALIGN="LEFT"><U>ma_icd10</U></TD></TR>
    <TR><TD ALIGN="LEFT">mo_ta</TD></TR></TABLE>>];
  DON_THUOC [pos="1070,230!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#ffe6cc"><B>DON_THUOC</B></TD></TR>
    <TR><TD PORT="ma_don" ALIGN="LEFT"><U>ma_don</U></TD></TR>
    <TR><TD PORT="ma_lan_kham" ALIGN="LEFT">#ma_lan_kham</TD></TR>
    <TR><TD ALIGN="LEFT">thoi_diem_ke, trang_thai</TD></TR>
    <TR><TD PORT="created_by" ALIGN="LEFT">#created_by</TD></TR></TABLE>>];
  CHI_TIET_DON_THUOC [pos="1310,230!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#ffe6cc"><B>CHI_TIET_DON_THUOC</B></TD></TR>
    <TR><TD PORT="ma_don" ALIGN="LEFT"><U>#ma_don</U></TD></TR>
    <TR><TD PORT="ma_thuoc" ALIGN="LEFT"><U>#ma_thuoc</U></TD></TR>
    <TR><TD ALIGN="LEFT">so_luong, lieu_dung</TD></TR></TABLE>>];
  THUOC [pos="1310,70!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#fff2cc"><B>THUOC</B></TD></TR>
    <TR><TD PORT="ma_thuoc" ALIGN="LEFT"><U>ma_thuoc</U></TD></TR>
    <TR><TD ALIGN="LEFT">ten_thuoc, dang_bao_che, ham_luong</TD></TR></TABLE>>];
  THUOC_HOAT_CHAT [pos="1070,70!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#ffe6cc"><B>THUOC_HOAT_CHAT</B></TD></TR>
    <TR><TD PORT="ma_thuoc" ALIGN="LEFT"><U>#ma_thuoc</U></TD></TR>
    <TR><TD PORT="ma_hoat_chat" ALIGN="LEFT"><U>#ma_hoat_chat</U></TD></TR>
    <TR><TD ALIGN="LEFT">ham_luong</TD></TR></TABLE>>];
  HOAT_CHAT [pos="830,70!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#fff2cc"><B>HOAT_CHAT</B></TD></TR>
    <TR><TD PORT="ma_hoat_chat" ALIGN="LEFT"><U>ma_hoat_chat</U></TD></TR>
    <TR><TD ALIGN="LEFT">ten_hoat_chat</TD></TR></TABLE>>];
  DI_UNG [pos="590,70!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
    <TR><TD BGCOLOR="#ffe6cc"><B>DI_UNG</B></TD></TR>
    <TR><TD PORT="ma_bn" ALIGN="LEFT"><U>#ma_bn</U></TD></TR>
    <TR><TD PORT="ma_hoat_chat" ALIGN="LEFT"><U>#ma_hoat_chat</U></TD></TR>
    <TR><TD ALIGN="LEFT">ngay_ghi_nhan, ghi_chu</TD></TR></TABLE>>];

  // ---------- Khóa ngoại: mũi tên từ khóa ngoại chỉ vào khóa được tham chiếu ----------
  BAC_SI:ma_bac_si -> NHAN_VIEN:ma_nv;
  BAC_SI_DA_KHOA:ma_bac_si -> BAC_SI:ma_bac_si;
  BAC_SI_CHUYEN_KHOA:ma_bac_si -> BAC_SI:ma_bac_si;
  BAC_SI_CHUYEN_KHOA:ma_chuyen_khoa -> CHUYEN_KHOA:ma_chuyen_khoa;
  CA_LAM_VIEC:ma_bac_si -> BAC_SI:ma_bac_si;

  GIAY_CHUYEN_KHOA:ma_bn -> BENH_NHAN:ma_bn;
  GIAY_CHUYEN_KHOA:ma_bac_si_lap -> BAC_SI_DA_KHOA:ma_bac_si;
  GIAY_CHUYEN_KHOA:ma_chuyen_khoa -> CHUYEN_KHOA:ma_chuyen_khoa;
  LICH_HEN:ma_bn -> BENH_NHAN:ma_bn;
  LICH_HEN:ma_bac_si -> BAC_SI:ma_bac_si;
  LICH_HEN:ma_giay -> GIAY_CHUYEN_KHOA:ma_giay [label=" (ma_giay, ma_bn)", fontsize=9];
  TAI_KHOAN:ma_bn -> BENH_NHAN:ma_bn;
  TAI_KHOAN:ma_nv -> NHAN_VIEN:ma_nv;

  LAN_KHAM:ma_lh -> LICH_HEN:ma_lh;
  LAN_KHAM:created_by -> TAI_KHOAN:ten_dang_nhap;
  CHAN_DOAN:ma_lan_kham -> LAN_KHAM:ma_lan_kham;
  CHAN_DOAN:ma_icd10 -> MA_ICD10:ma_icd10;
  DON_THUOC:ma_lan_kham -> LAN_KHAM:ma_lan_kham;
  DON_THUOC:created_by -> TAI_KHOAN:ten_dang_nhap;
  CHI_TIET_DON_THUOC:ma_don -> DON_THUOC:ma_don;
  CHI_TIET_DON_THUOC:ma_thuoc -> THUOC:ma_thuoc;
  THUOC_HOAT_CHAT:ma_thuoc -> THUOC:ma_thuoc;
  THUOC_HOAT_CHAT:ma_hoat_chat -> HOAT_CHAT:ma_hoat_chat;
  DI_UNG:ma_bn -> BENH_NHAN:ma_bn;
  DI_UNG:ma_hoat_chat -> HOAT_CHAT:ma_hoat_chat;
}
