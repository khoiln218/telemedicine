digraph LuocDoQuanHe {
  graph [rankdir=BT, splines=ortho, nodesep=0.2, ranksep=0.45, fontname="Helvetica", pad=0.2];
  node  [shape=plain, fontname="Helvetica", fontsize=10];
  edge  [arrowsize=0.6, color="#555555", fontname="Helvetica"];
    bac_si [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#dae8fc"><B>BAC_SI</B></TD></TR><TR><TD ALIGN="LEFT">#<U>ma_bac_si</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">so_chung_chi*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT">ngay_cap_cc*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">date</FONT></TD></TR><TR><TD ALIGN="LEFT">ngay_het_han_cc*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">date</FONT></TD></TR><TR><TD ALIGN="LEFT">loai_bac_si*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(16)</FONT></TD></TR></TABLE>>];
    bac_si_chuyen_khoa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#dae8fc"><B>BAC_SI_CHUYEN_KHOA</B></TD></TR><TR><TD ALIGN="LEFT">#<U>ma_bac_si</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_chuyen_khoa*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR></TABLE>>];
    bac_si_da_khoa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#dae8fc"><B>BAC_SI_DA_KHOA</B></TD></TR><TR><TD ALIGN="LEFT">#<U>ma_bac_si</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR></TABLE>>];
    ca_lam_viec [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#dae8fc"><B>CA_LAM_VIEC</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_ca</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">thoi_gian_bd*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">thoi_gian_kt*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">trang_thai*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(8)</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_bac_si*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR></TABLE>>];
    chuyen_khoa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#fff2cc"><B>CHUYEN_KHOA</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_chuyen_khoa</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ten_chuyen_khoa*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(100)</FONT></TD></TR></TABLE>>];
    nhan_vien [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#dae8fc"><B>NHAN_VIEN</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_nv</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ho_ten*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT">ngay_sinh*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">date</FONT></TD></TR><TR><TD ALIGN="LEFT">sdt*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT">loai_nv*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(24)</FONT></TD></TR></TABLE>>];
    benh_nhan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#d5e8d4"><B>BENH_NHAN</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_bn</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ho_ten*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT">ngay_sinh*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">date</FONT></TD></TR><TR><TD ALIGN="LEFT">gioi_tinh*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(3)</FONT></TD></TR><TR><TD ALIGN="LEFT">sdt*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(100)</FONT></TD></TR></TABLE>>];
    giay_chuyen_khoa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#d5e8d4"><B>GIAY_CHUYEN_KHOA</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_giay</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ngay_lap*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">date</FONT></TD></TR><TR><TD ALIGN="LEFT">ly_do*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="LEFT">ngay_het_han*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">date</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_bn*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_bac_si_lap*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_chuyen_khoa*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR></TABLE>>];
    lich_hen [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#d5e8d4"><B>LICH_HEN</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_lh</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">thoi_gian_bd*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">thoi_gian_kt*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">ly_do_kham*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="LEFT">trang_thai*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(11)</FONT></TD></TR><TR><TD ALIGN="LEFT">hinh_thuc*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(9)</FONT></TD></TR><TR><TD ALIGN="LEFT">phi_kham*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">numeric(12,0)</FONT></TD></TR><TR><TD ALIGN="LEFT">ngay_tao*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">phong_kham</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT">nen_tang</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT">link_phien</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_bn*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_bac_si*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_giay</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR></TABLE>>];
    tai_khoan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#d5e8d4"><B>TAI_KHOAN</B></TD></TR><TR><TD ALIGN="LEFT"><U>ten_dang_nhap</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT">mat_khau_hash*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT">vai_tro*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(18)</FONT></TD></TR><TR><TD ALIGN="LEFT">trang_thai*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(9)</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_bn</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_nv</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR></TABLE>>];
    chan_doan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#ffe6cc"><B>CHAN_DOAN</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_chan_doan</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_lan_kham*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_icd10*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT">la_chan_doan_chinh*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">ghi_chu</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="LEFT">trang_thai*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(8)</FONT></TD></TR></TABLE>>];
    chi_tiet_don_thuoc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#ffe6cc"><B>CHI_TIET_DON_THUOC</B></TD></TR><TR><TD ALIGN="LEFT">#<U>ma_don</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#<U>ma_thuoc</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">so_luong*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">lieu_dung*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">text</FONT></TD></TR></TABLE>>];
    di_ung [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#ffe6cc"><B>DI_UNG</B></TD></TR><TR><TD ALIGN="LEFT">#<U>ma_bn</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#<U>ma_hoat_chat</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ngay_ghi_nhan*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">date</FONT></TD></TR><TR><TD ALIGN="LEFT">ghi_chu</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">text</FONT></TD></TR></TABLE>>];
    don_thuoc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#ffe6cc"><B>DON_THUOC</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_don</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_lan_kham*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">thoi_diem_ke*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">trang_thai*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(8)</FONT></TD></TR><TR><TD ALIGN="LEFT">#created_by*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(50)</FONT></TD></TR></TABLE>>];
    hoat_chat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#fff2cc"><B>HOAT_CHAT</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_hoat_chat</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ten_hoat_chat*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(150)</FONT></TD></TR></TABLE>>];
    lan_kham [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#ffe6cc"><B>LAN_KHAM</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_lan_kham</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#ma_lh*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">thoi_diem_kham*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">tom_tat*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="LEFT">#created_by*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(50)</FONT></TD></TR></TABLE>>];
    ma_icd10 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#fff2cc"><B>MA_ICD10</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_icd10</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT">mo_ta*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(255)</FONT></TD></TR></TABLE>>];
    thuoc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#fff2cc"><B>THUOC</B></TD></TR><TR><TD ALIGN="LEFT"><U>ma_thuoc</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ten_thuoc*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT">dang_bao_che*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT">ham_luong*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(80)</FONT></TD></TR></TABLE>>];
    thuoc_hoat_chat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#ffe6cc"><B>THUOC_HOAT_CHAT</B></TD></TR><TR><TD ALIGN="LEFT">#<U>ma_thuoc</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">#<U>ma_hoat_chat</U></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ham_luong*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">varchar(80)</FONT></TD></TR></TABLE>>];
  bac_si -> nhan_vien;
  bac_si_chuyen_khoa -> bac_si;
  bac_si_chuyen_khoa -> chuyen_khoa;
