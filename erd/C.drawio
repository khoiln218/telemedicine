        <mxCell id="note" value="Giả định T13: một hồ sơ/bệnh nhân; một lần khám/lịch hẹn hoàn thành; bác sĩ và bệnh nhân được suy ra từ LICH_HEN. Các ràng buộc liên bảng BR-C01–C03 và BR-C05 cần trigger theo T09." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="260" height="130" as="geometry"/></mxCell>
